# doda_datalake — copy to .env (NEVER commit .env). Two-file deploy:
#   cp .env.example .env   # fill secrets, then:  docker compose up -d
# Arcane: paste each KEY=value into the project's Environment tab instead of
# uploading .env (same keys, same format).
#
# Interpolation (Docker Compose CLI feature, verified against official docs):
# - Unquoted and double-quoted .env values ARE interpolated: $VAR / ${VAR}
#   inside .env resolve from the shell environment before compose sees them.
# - Single-quoted .env values are LITERAL: VAR='${OTHER}' keeps ${OTHER}.
# - A literal dollar in compose.yaml itself is $$ (compose folds $$ -> $).
# - So: a password containing $ must be single-quoted here ('p@ss$word'),
#   or compose will try to expand it. '#' starts an inline comment only
#   after a space in unquoted values; inside quotes it is literal.
# - '=' inside a value is fine unquoted EXCEPT in GREPTIME_PASSWORD
#   (Greptime credential-line format forbids '=') — pick a password
#   without '=' or newline.
#
# Parity: every ${VAR} referenced by compose/*.yaml must have a KEY here.
# Check statically:  python3 tools/check_env.py
# Ground truth (real compose model, needs docker): docker compose config
# warns on unset vars; with this file loaded there must be no warnings.
#
# Profiles: COMPOSE_PROFILES=server always. Append mqtt and/or home on the
# mini PC; vehicle runs on the Pi (vehicle profile only); redecode runs
# manually for offline reprocessing (redecode profile only).
# home and mqtt are server add-ons, not standalone collector profiles.
#   server          : greptimedb + db-init + alloy + grafana + db-schema
#   server,mqtt     : + telegraf (existing broker consumer)
#   server,home     : + alloy-home (Home Assistant Prometheus scrape)
#   vehicle         : raw recorder/uploader + KUKSA + vss-recorder (Pi only)
#   redecode        : offline MF4 re-decode into a separate outbox (manual)
COMPOSE_PROFILES=server

# --- core (compose/core.yaml, profiles: server) ---
# Defaults apply when unset; preflight (db-init) fails fast naming the
# missing input (never its value) — compose config itself never fails on
# inactive-profile secrets (all refs are ${VAR:-} soft form).
# Images/pins are dotenv-overridable; not pinned here = renovate-style
# bump by editing the default after :- in the fragment.
GREPTIME_IMAGE=greptime/greptimedb:v1.2.1
PYTHON_IMAGE=python:3.12.8-slim-bookworm
GREPTIME_DB=datalake
GREPTIME_USER=datalake
GREPTIME_PASSWORD=
# S3 (S3-compatible storage) or File (local test mode only — same key set,
# S3_* ignored; File mode keeps SST on the greptime-data volume).
GREPTIME_STORAGE_TYPE=S3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Auto-derived from s3.<region>.backblaze... endpoints; set explicitly
# for custom endpoints.
S3_REGION=
# Object prefix (s3://bucket/root). Changing it on a used volume mixes
# metadata across backends: preflight fails closed; use backup/restore
# into a fresh volume instead.
S3_ROOT=greptime
# Paginated whole-bucket inventory; hourly by default to limit S3 list costs.
STORAGE_METRICS_INTERVAL_SEC=3600
# In-container URL other services use; host tools use the bind below.
GREPTIME_HTTP_URL=http://greptimedb:4000
# Bind addresses default to loopback. Remote clients (e.g. Pi outbox on
# the mini PC) set a Tailnet IP here — never 0.0.0.0 without a TLS/auth
# boundary in front; HTTP itself has only basic auth.
GREPTIME_HTTP_BIND_ADDRESS=127.0.0.1
GREPTIME_HTTP_PORT=4000
GREPTIME_MYSQL_BIND_ADDRESS=127.0.0.1
GREPTIME_MYSQL_PORT=4002
# Mito engine tuning (Podman-VM-safe defaults); wrong units fail preflight.
GREPTIME_PAGE_CACHE_SIZE=512MB
GREPTIME_WRITE_BUFFER_SIZE=128MB
GREPTIME_AUTO_FLUSH_INTERVAL=10m

# --- database (compose/database.yaml, profiles: server) ---
# Schema init waits for greptimedb HTTP; OTEL_TTL empty = keep OTel tables.
DB_INIT_WAIT_S=300
OTEL_TTL=
AGG_INTERVAL_SECONDS=300
AGG_LOOKBACK_HOURS=30
AGG_MAX_ROWS=200000
# Aggregate path/entity overrides (empty = script defaults / skip).
VEHICLE_SPEED_PATH=
VEHICLE_SOC_PATH=
# Independent monotonic consumed/charged energy counters (kWh or Wh).
VEHICLE_DRIVE_ENERGY_PATH=
VEHICLE_CHARGE_ENERGY_PATH=
# Dedicated charging power, not signed traction/regen power (kW or W).
VEHICLE_CHARGING_POWER_PATH=
VEHICLE_CHARGING_PATH=
# VEHICLE_ID is shared with the vehicle sections below (single definition).
TRIP_GAP_MINUTES=10
TRIP_MIN_SPEED_KPH=1
CHARGE_GAP_MINUTES=30
VEHICLE_SIGNAL_MAX_AGE_SECONDS=300
# Only explicitly configured sources are aggregated and expired.
# 0s disables Home raw expiry; long-term aggregates are retained.
HOME_RAW_TTL=90d
# Entries require all four keys; empty entity_col explicitly combines the table.
# Example: [{"table":"mqtt_consumer","time_col":"greptime_timestamp","entity_col":"topic","value_col":"temperature"},{"table":"homeassistant_sensor_temperature_celsius","time_col":"greptime_timestamp","entity_col":"entity","value_col":"greptime_value"}]
HOME_AGG_SOURCES=[]

# --- backup / recovery (compose/backup.yaml, profile: backup) ---
# Offline-only: stop (server profile), then run backup/restore (backup profile)
# with BACKUP_OFFLINE_CONFIRMED=1. Automated S3 SST snapshot + verified
# upload/download/restore is inside scripts/backup.py (boto3 pinned via
# backup-deps venv; real B2 unverified). Fresh-host recovery: fresh
# COMPOSE_PROJECT_NAME (empty volumes by construction), never volume rm on
# live data. BACKUP_FILE selects a local tar (default newest) or a remote
# backup id/name to download in S3 mode. No force flag exists.
BACKUP_KEEP=7
BACKUP_FILE=
# File-mode same-host restore: existing backup volume, new COMPOSE_PROJECT_NAME.
# Empty uses this project's own backup volume; S3 fresh-host restore downloads.
BACKUP_VOLUME_NAME=
# Set true with an existing BACKUP_VOLUME_NAME; recovery must not own/delete it.
BACKUP_VOLUME_EXTERNAL=false
BACKUP_OFFLINE_CONFIRMED=
S3_BACKUP_PREFIX=greptime-backups
BACKUP_IMAGE=python:3.12.8-slim-bookworm

# --- grafana (compose/grafana.yaml, profiles: server) ---
GRAFANA_IMAGE=grafana/grafana:12.4.0
GF_ADMIN_USER=admin
# Required: server preflight refuses empty (no default-admin boot).
GF_ADMIN_PASSWORD=
# Loopback default; Tailnet IP for remote browsers. Never 0.0.0.0 default.
GF_BIND_ADDRESS=127.0.0.1
GF_HTTP_PORT=3000

# --- alloy server (compose/ingest.yaml, profiles: server) ---
# Server accepts OTLP HTTP/protobuf and HTTP/JSON on the loopback ports below (basic auth
# OTLP_USER/OTLP_PASSWORD, both required — anonymous ingest is refused).
# Producer exporter/protocol/auth (source-verified exact values only).
# Values below name the producer-side setting that sends here; auth on the
# wire is always the Basic OTLP_USER/OTLP_PASSWORD pair below.
# Bundled metadata-only plugins (Node.js 22+, install on each agent machine):
#   npm ci --prefix plugins
#   node plugins/configure.mjs --endpoint http://127.0.0.1:4318 --from-env-file .env --apply
#   node plugins/install.mjs <codex|omp|opencode2|claude-code> --apply
# Configure/install default to dry-run. See each command's --help; Codex
# supports --codex PATH when its binary is outside PATH. Restart clients.
# The private 0600 config contains only the endpoint/auth, never storage keys.
# Remote collectors require HTTPS or a loopback tunnel by default. An explicit
# --allow-insecure-http permits private IPv4 LAN HTTP with unencrypted credentials;
# bind only that LAN IP, never 0.0.0.0. Never commit the private config.
# Unrelated settings are preserved; see plugins/README.md for the security tradeoff.
# Native adapters: Codex 0.142.4 hooks/active numeric rollout, OMP 18.2.6
# extension, OpenCode 2.0.1/2.0.12 server plugin, Claude Code 2.1.223 hooks.
# Content is excluded before HTTP/JSON transmission, not just at the server.
# OMP/OpenCode forward their reported USD costs; Codex/Claude hook costs
# remain missing when not supplied. No inferred accepted LOC/commit/PR counts.
# Codex requires explicit /hooks trust; choose plugin OR native source.
# OMP delegates usage only to native traces targeting the same endpoint.
# Claude fallback tokens remain available; received native usage wins below.
# Use a local OTel collector for durable offline client delivery.
# - Claude Code native OTel (terminal/Desktop): resource service.name is
#   exactly 'claude-code' (terminal) or 'claude-code-desktop' (Desktop Code
#   tab) sending logs+metrics (traces beta) via OTLP http/protobuf. The
#   underscore 'claude_code' spelling is only the native metric/event
#   namespace, never service identity. Client-side settings (not Compose vars):
#   CLAUDE_CODE_ENABLE_TELEMETRY=1; OTEL_METRICS_EXPORTER=otlp;
#   OTEL_LOGS_EXPORTER=otlp; OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf;
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector>:4318;
#   OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 user:password>".
#   Keep content opt-ins OTEL_LOG_* disabled. Canonicalizes to 'claude-code'.
#   Source: https://code.claude.com/docs/en/monitoring-usage
# - Codex native OTel: codex.* event/metric namespace (sse_event completed,
#   turn_cost, tool_result, tool_decision) via OTLP http/protobuf. Native
#   service.name is runtime originator/override-dependent (openai/codex
#   codex-rs/core/src/otel_init.rs), so no fixed literal is mapped: identity
#   is the codex.* namespace or explicit coding_agent.client only. No
#   per-producer exporter flags established here. Canonicalizes to 'codex'.
# - OMP native traces: resource service.name fallback exactly 'oh-my-pi'
#   (can1357/oh-my-pi packages/coding-agent/src/telemetry-export-otlp.ts),
#   overridable via standard OTEL_RESOURCE_ATTRIBUTES/OTEL_SERVICE_NAME.
#   Sends traces natively via OTLP http/protobuf. Canonicalizes to 'oh-my-pi'.
# - OpenLIT: NO verified native mapping in this repo. A client without
#   native support is NOT auto-integrated — its coding_agent.client label is
#   authoritative verbatim (e.g. OpenLIT 'codex'/'claude-code' vendor
#   constants in openlit/cli/gen/semconv.ts). Recommended path is an OpenLIT
#   OTel pipeline with content capture metadata_only pointed here; no
#   exporter flags are invented by this repo.
# - OpenCode 2: plugins/opencode2 uses the native event stream and explicit
#   coding_agent.client=opencode. service.name retains ctx.app.name provenance.
#   Classic OpenCode v1 is not supported by this adapter.
# Alloy adds the greptime_trace_v1 pipeline header itself.
# Usage policy: native tokens win within an identified (client, session);
# unmatched fallback spans remain timing/tool context, not extra usage.
# Mixed native-only/span-only coverage in one session can undercount: align
# producer coverage rather than assuming different request IDs are linkable.
# Codex turn totals replace same-turn call costs before model/day grouping;
# absent turn/model identity is never guessed into an allocation.
OTLP_USER=
OTLP_PASSWORD=
OTLP_GRPC_BIND_ADDRESS=127.0.0.1
OTLP_GRPC_PORT=4317
OTLP_HTTP_BIND_ADDRESS=127.0.0.1
OTLP_HTTP_PORT=4318
ALLOY_IMAGE=grafana/alloy:v1.19.2
# Tuning (compose-time, password-safe; privacy/fsync/retry stay fixed).
OTLP_QUEUE_SIZE=1000
OTLP_BATCH_MIN_SIZE=200
OTLP_BATCH_MAX_SIZE=500
OTLP_BATCH_FLUSH_TIMEOUT=5s
INFRA_SCRAPE_INTERVAL=30s
# '[]' = no scrape (absent series = not-configured, not outage). mqtt on:
# TELEGRAF_SCRAPE_TARGETS='[{"__address__":"telegraf:9273","job":"telegraf"}]'.
TELEGRAF_SCRAPE_TARGETS=[]
# Pi exporters (Tailnet IP), e.g. '[{"__address__":"<pi>:9102",
# "job":"vehicle-raw-recorder"},{"__address__":"<pi>:9103",
# "job":"vehicle-raw-uploader"},{"__address__":"<pi>:9104","job":"vss-recorder"}]'.
VEHICLE_METRICS_TARGETS=[]

# --- alloy-home (compose/ingest.yaml, profiles: home) ---
HA_HOST=127.0.0.1:8123
HA_SCHEME=http
HA_TOKEN="" # Set only in your private .env.
HA_SCRAPE_INTERVAL=60s
# --- telegraf mqtt (compose/ingest.yaml, profiles: mqtt) ---
# Existing broker only — this repo never runs its own broker.
# Restart durability = producer QoS1 + broker persistence + UNCHANGED
# MQTT_CLIENT_ID below (persistent session identity). Telegraf v1.40
# models/buffer_disk.go BeginTransaction deliberately discards tracking
# metrics recovered from a prior process (ErrSkipTracking/originalEnd) and
# expects broker redelivery: disk_write_through+fsync does NOT independently
# replay MQTT on its own. A proven QoS0/non-retained sample was still lost
# after 503+SIGKILL+container replacement despite the disk buffer — this is
# the upstream contract (at-least-once: QoS1 redelivery may also duplicate),
# not a collector defect. v4§36/38 requires persistent consumer + QoS1 +
# stable ID, not a broker-independent QoS0 WAL. MQTT restart durability was
# proven with QoS1 only. --profile mqtt alone does not start db-schema
# (profile isolation); Main owns that fix separately.
TELEGRAF_IMAGE=telegraf:1.40.0
TELEGRAF_BIND_ADDRESS=127.0.0.1
TELEGRAF_PORT=9273
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
# JSON array string of topics, e.g. '["home/#"]'.
MQTT_TOPICS=
# Persistent session identity: keep UNCHANGED across restarts or the broker
# treats this consumer as new and QoS1 redelivery is lost.
MQTT_CLIENT_ID=doda-datalake
MQTT_DATA_FORMAT=json

# --- vehicle raw (compose/vehicle-raw.yaml, profiles: vehicle) ---
VEHICLE_RAW_IMAGE=python:3.12.8-slim-bookworm
CAN_INTERFACE=can0
VEHICLE_ID=
# Spool path is fixed in compose (/spool/raw); no dotenv knob.
RAW_CHUNK_SECONDS=600
RAW_CHUNK_BYTES=67108864
RAW_FSYNC_N=50
RAW_FSYNC_SEC=1.0
RAW_DISK_MIN_FREE_BYTES=1073741824
# Recorder metrics bind (host network_mode): loopback default, Tailnet IP
# via dotenv. Uploader serves fixed 9103 bound to RAW_METRICS_HOST;
# compose maps the host port below.
RAW_METRICS_HOST=127.0.0.1
RAW_METRICS_PORT=9102
RAW_REPLAY_ALLOW=0
# Archive keys: raw/vehicle/<id>/can/YYYY/MM/DD/<manifest-sha256>/<original filename>.
# The manifest pins MF4 and ingress sidecar bytes, so every triple is content-addressed.
# Identical retries reuse verified objects; conflicting/unreadable objects keep the local spool.
# Reserve this prefix for these uploaders: compliant writers sharing a key have identical bytes.
# Standard PUT keeps B2 compatibility; no unsupported If-None-Match requirement.
RAW_BUCKET=
RAW_S3_ENDPOINT_URL=
RAW_S3_REGION=us-west-004
RAW_S3_ACCESS_KEY_ID=
RAW_S3_SECRET_ACCESS_KEY=
RAW_UPLOAD_INTERVAL_SEC=60
RAW_UPLOAD_RETRIES=8
RAW_UPLOAD_METRICS_PORT=9103
RAW_INVENTORY_INTERVAL_SEC=3600
# Optional, observational checks on each sealed chunk using pinned epoch DBCs.
# Empty rules mean unconfigured, not successful checksum/signal validation.
CAN_VALIDATION_CHECKSUMS={}
CAN_VALIDATION_RANGES={}
CAN_VALIDATION_EXPECTED_SIGNALS=[]
CAN_VALIDATION_RELATIONS={}
# Schema examples only, NOT Tesla firmware calibration; use verified values.
# CAN_VALIDATION_CHECKSUMS='{"256":{"algorithm":"sum8","checksum_byte":7,"start":0,"end":7,"id_bytes":0}}'
# CAN_VALIDATION_RANGES='{"PackVoltage":{"min":300,"max":420}}'
# CAN_VALIDATION_EXPECTED_SIGNALS='["PackVoltage","PackPower"]'
# CAN_VALIDATION_RELATIONS='{"pack_power":{"result":"PackPower","left":"PackVoltage","right":"PackCurrent","op":"product","factor":1,"abs_tolerance":100,"rel_tolerance":0.02,"max_age_seconds":1}}'

# --- vehicle vss (compose/vehicle-vss.yaml, profiles: vehicle) ---
# VEHICLE_ID and CAN_INTERFACE shared with vehicle-raw section above.
VEHICLE_VSS_IMAGE=python:3.12.8-slim-bookworm
KUKSA_DATABROKER_IMAGE=ghcr.io/eclipse-kuksa/kuksa-databroker:0.7.1
KUKSA_CAN_PROVIDER_IMAGE=ghcr.io/eclipse-kuksa/kuksa-can-provider/can-provider:0.5.0
KUKSA_PORT=55555
VEHICLE_FIRMWARE=
VSS_VERSION=
DECODE_EPOCH=
# Pin/epoch updates are a quiesced vehicle restart, not a hot DBC swap:
#   docker compose --profile vehicle stop raw-recorder vss-recorder kuksa-can-provider kuksa-databroker
# Then change firmware/VSS/DBC pins and DECODE_EPOCH, and run compose up -d.
# This prevents a still-running decoder and recorder from using different generations.
# DBC provenance (enforced by scripts/vehicle_setup.py): PRIMARY and
# SUPPLEMENTAL COMMIT are REQUIRED full Git hashes (40/64 hex); without them
# setup exits non-zero. VSS mapping is locally-authored: VSS_VERSION and the
# local overlay version are required by v4§23/47, VSS_MAPPING_COMMIT stays
# OPTIONAL (set only when the mapping itself is pinned to a Git commit).
# DBC_OVERRIDE_VERSION is required only when DBC_OVERRIDE_URL is set.
DBC_PRIMARY_URL=
DBC_PRIMARY_SHA256=
DBC_PRIMARY_COMMIT=
DBC_SUPPLEMENTAL_URL=
DBC_SUPPLEMENTAL_SHA256=
DBC_SUPPLEMENTAL_COMMIT=
DBC_OVERRIDE_URL=
DBC_OVERRIDE_SHA256=
DBC_OVERRIDE_COMMIT=
DBC_OVERRIDE_VERSION=
VSS_MAPPING_URL=
VSS_MAPPING_SHA256=
VSS_MAPPING_COMMIT=
OUTBOX_PATH=/data/outbox.sqlite
VSS_BATCH_N=500
VSS_FLUSH_SEC=10
# Loopback by default; use the Pi Tailnet IP for remote Alloy health scrapes.
VSS_METRICS_HOST=127.0.0.1
VSS_METRICS_PORT=9104
COLLECTOR_VERSION=vss-recorder-1

# --- redecode (compose/redecode.yaml, profiles: redecode; manual offline runs) ---
# Reprocesses sealed MF4 into REDECODE_OUTBOX_PATH (never the live outbox).
# Greptime + manifest keys are the shared ones above (GREPTIME_HTTP_URL/
# DB/USER/PASSWORD, VEHICLE_ID, COLLECTOR_VERSION).
REDECODE_INPUT_URL=
REDECODE_INPUT_SHA256=
# Override derived sibling URLs when the MF4 URL is individually presigned.
REDECODE_INPUT_MANIFEST_URL=
REDECODE_INPUT_SIDECAR_URL=
# Required: prepares this immutable epoch automatically without switching live CAN.
REDECODE_DECODE_EPOCH=
REDECODE_VEHICLE_ID=
REDECODE_SPOOL_DIR=/spool/raw
REDECODE_WORKDIR=/data/redecode
REDECODE_OUTBOX_PATH=/data/redecode-outbox.sqlite
REDECODE_BATCH_N=500
REDECODE_COLLECTOR_VERSION=
REDECODE_IMAGE=python:3.12.8-slim-bookworm
# Blank selects /data/generations/<REDECODE_DECODE_EPOCH>/... .
MANIFEST_PATH=
MAPPING_PATH=
DBC_PRIMARY_PATH=
DBC_SUPPLEMENTAL_PATH=
KUKSA_SRC_DIR=/opt/venv/kuksa_verified

# --- retention / queue (informational; enforced by schema fragment) ---
# LLM OTel traces 30-90d; AI summaries indefinite; raw MF4 (S3) indefinite;
# canonical VSS long-term; high-freq debug + home raw 30-90d; home
# aggregates long-term. Alloy durable queue lives on its named volume.
