{
  "datalake-telemetry": {
    "PreInvocation": [
      { "type": "command", "command": "node hook.mjs --pre-invocation", "timeout": 5 }
    ],
    "PostInvocation": [
      { "type": "command", "command": "node hook.mjs --post-invocation", "timeout": 5 }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook.mjs --pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hook.mjs --stop",
        "timeout": 15
      }
    ]
  }
}
