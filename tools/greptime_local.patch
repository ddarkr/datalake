index 0000000..132d568
--- /dev/null
+++ b/src/mito2/src/cache/sst_mirror.rs
@@ -0,0 +1,276 @@
+// Copyright 2026 Greptime Team
+// Licensed under the Apache License, Version 2.0.
+
+//! Non-evicting immutable local inputs. S3 remains the canonical output store.
+//! Quota counts payload bytes once, including uncommitted published outputs.
+//! One maintenance reservation admits a fixed aggregate output budget; concurrent
+//! flushes also consume that budget. Free-space checks are admission, not physical
+//! preallocation: link/fsync errors still abort publication before remote upload.
+
+use std::collections::HashMap;
+use std::fs::{self, File};
+use std::path::{Component, Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+use object_store::{ErrorKind, ObjectStore};
+use snafu::IntoError;
+
+use crate::access_layer::new_fs_cache_store;
+use crate::error::{OpenDalSnafu, Result};
+
+fn failure(marker: &str, detail: impl std::fmt::Display) -> crate::error::Error {
+    OpenDalSnafu.into_error(object_store::Error::new(ErrorKind::Unexpected, format!("{marker}: {detail}")))
+}
+fn io<T>(value: std::io::Result<T>) -> Result<T> {
+    value.map_err(|e| failure("SST_MIRROR_IO", e))
+}
+
+#[derive(Debug)]
+struct Entry { size: u64, pins: usize, deleting: bool }
+#[derive(Default, Debug)]
+struct State {
+    entries: HashMap<String, Entry>,
+    used: u64,
+    remaining_output: Option<u64>,
+}
+
+#[derive(Debug)]
+pub(crate) struct SstMirror {
+    root: PathBuf,
+    store: ObjectStore,
+    capacity: u64,
+    output_reserve: u64,
+    // ponytail: one maintenance output budget; queue concurrent jobs instead of rejecting them.
+    maintenance: Arc<tokio::sync::Semaphore>,
+    // ponytail: serialize filesystem publication/deletion; shard only if measured contention warrants it.
+    state: Mutex<State>,
+    _lock: File,
+}
+
+impl SstMirror {
+    pub(crate) async fn new(path: &str, capacity: u64, output_reserve: u64) -> Result<Arc<Self>> {
+        if path.trim().is_empty() || capacity == 0 || output_reserve == 0 || output_reserve > capacity {
+            return Err(failure("SST_MIRROR_CAPACITY", "nonempty path and 0 < output reserve <= capacity required"));
+        }
+        let root = Path::new(path).join("objects");
+        io(fs::create_dir_all(&root))?;
+        let root = io(fs::canonicalize(root))?;
+        let lock = io(fs::OpenOptions::new().read(true).write(true).create(true)
+            .truncate(false).open(root.parent().unwrap().join("mirror.lock")))?;
+        io(fs2::FileExt::try_lock_exclusive(&lock))?;
+        let store = new_fs_cache_store(root.to_str().ok_or_else(|| failure("SST_MIRROR_IO", "non UTF-8 path"))?).await?;
+        let mut state = State::default();
+        fn scan(root: &Path, dir: &Path, state: &mut State) -> Result<()> {
+            for entry in io(fs::read_dir(dir))? {
+                let entry = io(entry)?;
+                let kind = io(entry.file_type())?;
+                if kind.is_symlink() { return Err(failure("SST_MIRROR_IO", "symlink in mirror namespace")); }
+                if kind.is_dir() { scan(root, &entry.path(), state)?; }
+                else if kind.is_file() {
+                    let path = entry.path();
+                    let key = path.strip_prefix(root).unwrap().to_string_lossy().into_owned();
+                    let size = io(entry.metadata())?.len();
+                    state.used = state.used.checked_add(size).ok_or_else(|| failure("SST_MIRROR_CAPACITY", "size overflow"))?;
+                    state.entries.insert(key, Entry { size, pins: 0, deleting: false });
+                }
+            }
+            Ok(())
+        }
+        scan(&root, &root, &mut state)?;
+        if state.used > capacity { return Err(failure("SST_MIRROR_CAPACITY", "existing mirror exceeds quota")); }
+        // Probe actual writable/durable setup; no mirrorless fallback.
+        let probe = root.join(".startup-probe");
+        io(File::create(&probe))?.sync_all().map_err(|e| failure("SST_MIRROR_IO", e))?;
+        io(fs::remove_file(probe))?;
+        io(File::open(&root))?.sync_all().map_err(|e| failure("SST_MIRROR_IO", e))?;
+        Ok(Arc::new(Self { root, store, capacity, output_reserve,
+            maintenance: Arc::new(tokio::sync::Semaphore::new(1)),
+            state: Mutex::new(state), _lock: lock }))
+    }
+
+    pub(crate) fn validate_cache_store(&self, cache: &ObjectStore) -> Result<()> {
+        if cache.info().scheme() != "fs" {
+            return Err(failure("SST_MIRROR_IO", "mirror requires filesystem write cache"));
+        }
+        let cache_root = io(fs::canonicalize(cache.info().root()))?;
+        let evicting_namespace = cache_root.join("cache");
+        let atomic_namespace = cache_root.join(object_store::ATOMIC_WRITE_DIR);
+        if self.root.starts_with(&evicting_namespace) || evicting_namespace.starts_with(&self.root)
+            || self.root.starts_with(&atomic_namespace) || atomic_namespace.starts_with(&self.root) {
+            return Err(failure("SST_MIRROR_IO", "mirror must have a separate persistent namespace"));
+        }
+        let probe = self.root.join(".link-probe");
+        let source = cache_root.join(".mirror-link-probe");
+        let file = io(fs::OpenOptions::new().write(true).create_new(true).open(&source))?;
+        let result = fs::hard_link(&source, &probe);
+        drop(file);
+        let _ = fs::remove_file(&source);
+        if result.is_ok() { io(fs::remove_file(&probe))?; }
+        io(result)
+    }
+
+    pub(crate) fn store(&self) -> ObjectStore { self.store.clone() }
+
+    fn path(&self, key: &str) -> Result<PathBuf> {
+        if key.is_empty() || Path::new(key).components().any(|c| !matches!(c, Component::Normal(_))) {
+            return Err(failure("SST_MIRROR_IO", "invalid object key"));
+        }
+        Ok(self.root.join(key))
+    }
+
+    fn sync_path(&self, key: &str) -> Result<()> {
+        let path = self.path(key)?;
+        io(File::open(&path)).map_err(|_| failure("SST_MIRROR_MISS", key))?.sync_all().map_err(|e| failure("SST_MIRROR_IO", e))?;
+        let mut parent = path.parent();
+        while let Some(dir) = parent {
+            io(File::open(dir))?.sync_all().map_err(|e| failure("SST_MIRROR_IO", e))?;
+            if dir == self.root { break; }
+            parent = dir.parent();
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn validate_paths(&self, paths: &[String]) -> Result<()> {
+        let state = self.state.lock().unwrap();
+        for key in paths {
+            let entry = state.entries.get(key).filter(|e| !e.deleting).ok_or_else(|| failure("SST_MIRROR_MISS", key))?;
+            if io(fs::metadata(self.path(key)?))?.len() != entry.size { return Err(failure("SST_MIRROR_MISS", key)); }
+            self.sync_path(key)?;
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn lease_paths(self: &Arc<Self>, paths: &[String]) -> Result<MirrorLease> {
+        self.validate_paths(paths).await?;
+        let mut state = self.state.lock().unwrap();
+        // Validate again under the same lock as deletion, before pinning anything.
+        for key in paths {
+            if !state.entries.get(key).is_some_and(|e| !e.deleting) { return Err(failure("SST_MIRROR_MISS", key)); }
+        }
+        for key in paths { state.entries.get_mut(key).unwrap().pins += 1; }
+        Ok(MirrorLease { mirror: self.clone(), paths: paths.to_vec() })
+    }
+
+    pub(crate) async fn reserve_output(self: &Arc<Self>) -> Result<MirrorReservation> {
+        let permit = self.maintenance.clone().acquire_owned().await
+            .map_err(|error| failure("SST_MIRROR_RESERVATION", error))?;
+        let mut state = self.state.lock().unwrap();
+        if self.capacity - state.used < self.output_reserve || io(fs2::available_space(&self.root))? < self.output_reserve {
+            return Err(failure("SST_MIRROR_CAPACITY", "insufficient quota or filesystem headroom"));
+        }
+        state.remaining_output = Some(self.output_reserve);
+        Ok(MirrorReservation { mirror: self.clone(), _permit: permit })
+    }
+
+    /// Only accepts already-complete immutable local files; never reads S3.
+    /// A hardlink survives cache eviction (unlink), without duplicate payload blocks.
+    pub(crate) async fn publish(&self, source: &Path, key: &str) -> Result<()> {
+        let dest = self.path(key)?;
+        let size = io(fs::metadata(source))?.len();
+        let mut state = self.state.lock().unwrap();
+        if state.entries.contains_key(key) {
+            return Err(failure("SST_MIRROR_IO", "immutable object key already published"));
+        }
+        if size > self.capacity - state.used || state.remaining_output.is_some_and(|remaining| size > remaining) {
+            return Err(failure("SST_MIRROR_CAPACITY", "output exceeds hard quota or reserved output budget"));
+        }
+        // Hardlinking allocates metadata only, but still require output-sized free
+        // headroom so a full filesystem cannot pass maintenance publication.
+        if io(fs2::available_space(&self.root))? < size { return Err(failure("SST_MIRROR_CAPACITY", "filesystem headroom exhausted")); }
+        io(fs::create_dir_all(dest.parent().unwrap()))?;
+        io(File::open(source))?.sync_all().map_err(|e| failure("SST_MIRROR_IO", e))?;
+        io(fs::hard_link(source, &dest))?;
+        if let Err(error) = self.sync_path(key) {
+            let _ = fs::remove_file(&dest);
+            return Err(error);
+        }
+        state.used += size;
+        if let Some(remaining) = &mut state.remaining_output { *remaining -= size; }
+        state.entries.insert(key.to_string(), Entry { size, pins: 0, deleting: false });
+        Ok(())
+    }
+
+    pub(crate) async fn delete(&self, key: &str) -> Result<()> {
+        let mut state = self.state.lock().unwrap();
+        if let Some(entry) = state.entries.get_mut(key) {
+            entry.deleting = true;
+            if entry.pins != 0 { return Ok(()); }
+            self.remove_locked(key, &mut state)?;
+        }
+        Ok(())
+    }
+
+    fn remove_locked(&self, key: &str, state: &mut State) -> Result<()> {
+        match fs::remove_file(self.path(key)?) {
+            Ok(()) => (),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => (),
+            Err(e) => return Err(failure("SST_MIRROR_IO", e)),
+        }
+        if let Some(entry) = state.entries.remove(key) { state.used -= entry.size; }
+        Ok(())
+    }
+}
+
+pub(crate) struct MirrorReservation {
+    mirror: Arc<SstMirror>,
+    _permit: tokio::sync::OwnedSemaphorePermit,
+}
+impl Drop for MirrorReservation {
+    fn drop(&mut self) { self.mirror.state.lock().unwrap().remaining_output = None; }
+}
+pub(crate) struct MirrorLease { mirror: Arc<SstMirror>, paths: Vec<String> }
+impl Drop for MirrorLease {
+    fn drop(&mut self) {
+        let mut state = self.mirror.state.lock().unwrap();
+        for key in &self.paths {
+            if let Some(entry) = state.entries.get_mut(key) {
+                entry.pins -= 1;
+                if entry.pins == 0 && entry.deleting {
+                    // Failed cleanup stays charged and can be retried, never frees quota early.
+                    let _ = self.mirror.remove_locked(key, &mut state);
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn retention_leases_quota_and_local_miss() {
+        let dir = common_test_util::temp_dir::create_temp_dir("sst-mirror");
+        let root = dir.path().join("mirror");
+        let mirror = SstMirror::new(root.to_str().unwrap(), 32, 8).await.unwrap();
+        let source = dir.path().join("cache-file");
+        fs::write(&source, [1u8; 8]).unwrap();
+        mirror.publish(&source, "table/a.parquet").await.unwrap();
+        fs::remove_file(&source).unwrap(); // LRU eviction only unlinks its own name.
+        let key = "table/a.parquet".to_string();
+        let lease = mirror.lease_paths(std::slice::from_ref(&key)).await.unwrap();
+        assert_eq!(fs::read(root.join("objects").join(&key)).unwrap(), [1u8; 8]);
+        let reserve = mirror.reserve_output().await.unwrap();
+        assert!(tokio::time::timeout(
+            std::time::Duration::from_millis(1), mirror.reserve_output(),
+        ).await.is_err());
+        fs::write(&source, [2u8; 8]).unwrap();
+        mirror.publish(&source, "table/b.123.puffin").await.unwrap();
+        fs::remove_file(&source).unwrap();
+        fs::write(&source, [3u8; 1]).unwrap();
+        assert!(mirror.publish(&source, "table/c.parquet").await.is_err());
+        assert!(mirror.publish(&source, &key).await.is_err());
+        assert_eq!(fs::read(root.join("objects").join(&key)).unwrap(), [1u8; 8]);
+        assert!(mirror.lease_paths(&["missing.parquet".to_string()]).await.is_err());
+        mirror.delete(&key).await.unwrap();
+        assert!(root.join("objects").join(&key).exists());
+        drop(lease);
+        assert!(!root.join("objects").join(&key).exists());
+        assert!(mirror.store().read("absent.parquet").await.is_err());
+        drop(reserve);
+        assert!(mirror.reserve_output().await.is_ok());
+        assert!(SstMirror::new(root.to_str().unwrap(), 32, 8).await.is_err());
+        drop(mirror);
+        let reopened = SstMirror::new(root.to_str().unwrap(), 32, 8).await.unwrap();
+        reopened.validate_paths(&["table/b.123.puffin".to_string()]).await.unwrap();
+    }
+}
