+        let Some(names) = extract_tables_from_statement_checked(stmt) else {
+            return InvalidSqlSnafu { err_msg: "unresolved local SST query tables" }.fail();
+        };
+        let mut pending = names.map(|name| table_idents_to_full_name(&name, ctx))
+            .collect::<std::result::Result<Vec<_>, _>>()
+            .map_err(BoxedError::new).context(ExternalSnafu)?;
+        let mut visited = std::collections::HashSet::new();
+        while let Some((catalog, schema, table)) = pending.pop() {
+            if !visited.insert((catalog.clone(), schema.clone(), table.clone())) {
+                continue;
+            }
+            if let Some(table) = self.catalog_manager.table(&catalog, &schema, &table, Some(ctx))
+                .await.map_err(BoxedError::new).context(ExternalSnafu)?
+            {
+                let info = table.table_info();
+                if info.table_type == table::metadata::TableType::View {
+                    let manager = self.catalog_manager.as_any()
+                        .downcast_ref::<catalog::kvbackend::KvBackendCatalogManager>()
+                        .ok_or_else(|| InvalidSqlSnafu {
+                            err_msg: "unsupported local SST view catalog",
+                        }.build())?;
+                    let view = manager.view_info_cache()
+                        .map_err(BoxedError::new).context(ExternalSnafu)?
+                        .get(info.ident.table_id).await
+                        .map_err(BoxedError::new).context(ExternalSnafu)?
+                        .ok_or_else(|| InvalidSqlSnafu { err_msg: "missing local SST view metadata" }.build())?;
+                    for definition in parse_stmt(&view.definition, ctx.sql_dialect())? {
+                        match definition {
+                            Statement::CreateView(definition) => validate_local_sst_statement(&definition.query)?,
+                            definition => validate_local_sst_statement(&definition)?,
+                        }
+                    }
+                    pending.extend(view.table_names.iter().map(|name| (
+                        name.catalog_name.clone(), name.schema_name.clone(), name.table_name.clone(),
+                    )));
+                }
+                ensure!(
+                    matches!(info.meta.engine.as_str(), "mito" | "metric")
+                        || info.table_type == table::metadata::TableType::View
+                        || (info.table_type == table::metadata::TableType::Temporary
+                            && matches!(schema.as_str(), "information_schema" | "pg_catalog")
+                            && !matches!(info.name.as_str(), "ssts_storage" | "ssts_index_meta")),
+                    InvalidSqlSnafu { err_msg: "table is not supported by local SST query policy" }
+                );
+            }
+        }
+        Ok(())
+    }
