+fn validate_local_sst_statement(stmt: &Statement) -> Result<()> {
+    use sqlparser::ast::{Visit, Visitor, TableFactor};
+    struct LocalRelations;
+    impl Visitor for LocalRelations {
+        type Break = ();
+        fn pre_visit_table_factor(&mut self, factor: &TableFactor) -> std::ops::ControlFlow<()> {
+            match factor {
+                TableFactor::Table { args: None, .. }
+                | TableFactor::Derived { .. }
+                | TableFactor::NestedJoin { .. } => std::ops::ControlFlow::Continue(()),
+                _ => std::ops::ControlFlow::Break(()),
+            }
+        }
+    }
+    ensure!(!matches!(stmt.visit(&mut LocalRelations), std::ops::ControlFlow::Break(())),
+        InvalidSqlSnafu { err_msg: "table functions are unsupported in local SST queries" });
+    use sql::statements::alter::AlterTableOperation;
+    let supported = match stmt {
+        Statement::Query(_) | Statement::Insert(_) | Statement::Delete(_)
+        | Statement::DescribeTable(_) | Statement::ShowDatabases(_)
+        | Statement::ShowTables(_) | Statement::ShowColumns(_)
+        | Statement::ShowCreateTable(_) | Statement::ShowSearchPath(_)
+        | Statement::ShowVariables(_) => true,
+        Statement::CreateTable(table) => table.engine.eq_ignore_ascii_case("mito"),
+        Statement::AlterTable(table) => matches!(
+            table.alter_operation,
+            AlterTableOperation::AddColumns { .. }
+                | AlterTableOperation::DropColumn { .. }
+                | AlterTableOperation::ModifyColumnType { .. }
+                | AlterTableOperation::RenameTable { .. }
+                | AlterTableOperation::DropDefaults { .. }
+                | AlterTableOperation::SetDefaults { .. }
+        ),
+        _ => false,
+    };
+    ensure!(supported, InvalidSqlSnafu {
+        err_msg: "statement is not supported by local SST query policy",
+    });
+    Ok(())
+}
